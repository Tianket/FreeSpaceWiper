<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AppTitle"
                android:text="@string/app_name" />

            <Button
                android:id="@+id/btn_help"
                style="@style/TextButton"
                android:text="@string/menu_help" />

            <Button
                android:id="@+id/btn_lang"
                style="@style/TextButton"
                android:text="@string/btn_language" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_intro"
            style="@style/Hint"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/intro" />

        <!-- Only what needs attention -->
        <LinearLayout
            android:id="@+id/panel_warn"
            style="@style/WarnCard"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/warn_power"
                style="@style/WarnLine" />

            <TextView
                android:id="@+id/warn_battery"
                style="@style/WarnLine"
                android:text="@string/warn_battery" />

            <TextView
                android:id="@+id/warn_notif"
                style="@style/WarnLine"
                android:text="@string/warn_notif" />
        </LinearLayout>

        <!-- Progress while running, result when finished -->
        <LinearLayout
            android:id="@+id/panel_status"
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp">

                <app.freespacewiper.RingProgressView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/txt_percent"
                    style="@style/BigNumber"
                    android:layout_gravity="center" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_phase"
                style="@style/Title"
                android:layout_marginTop="14dp"
                android:gravity="center_horizontal" />

            <LinearLayout
                android:id="@+id/panel_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCell">

                        <TextView
                            android:id="@+id/lbl_written"
                            style="@style/StatLabel"
                            android:text="@string/stat_written" />

                        <TextView
                            android:id="@+id/stat_written"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/StatCell"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/lbl_free"
                            style="@style/StatLabel"
                            android:text="@string/stat_free" />

                        <TextView
                            android:id="@+id/stat_free"
                            style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/StatCell">

                        <TextView
                            android:id="@+id/lbl_speed"
                            style="@style/StatLabel"
                            android:text="@string/stat_speed" />

                        <TextView
                            android:id="@+id/stat_speed"
                            style="@style/StatValue" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/StatCell"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/lbl_eta"
                            style="@style/StatLabel"
                            android:text="@string/stat_eta" />

                        <TextView
                            android:id="@+id/stat_eta"
                            style="@style/StatValue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Two lines are always reserved, so the buttons below never move under the finger -->
            <TextView
                android:id="@+id/txt_detail"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:minLines="2" />

            <TextView
                android:id="@+id/txt_stall"
                style="@style/Warn"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_result"
                style="@style/Body"
                android:layout_marginTop="12dp"
                android:breakStrategy="balanced"
                android:gravity="center_horizontal"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/panel_run_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_pause"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_pause" />

                <Button
                    android:id="@+id/btn_stop"
                    style="@style/OutlineButton"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/btn_stop" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_dismiss"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/btn_dismiss"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Leftovers of an interrupted run -->
        <LinearLayout
            android:id="@+id/panel_leftover"
            style="@style/Card"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_leftover"
                style="@style/Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_delete_leftover"
                    style="@style/TextButton"
                    android:text="@string/btn_delete_leftover" />

                <Button
                    android:id="@+id/btn_resume"
                    style="@style/TextButton"
                    android:text="@string/btn_resume" />
            </LinearLayout>
        </LinearLayout>

        <!-- Setup: hidden while a wipe runs or a result is shown -->
        <LinearLayout
            android:id="@+id/panel_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Section"
                android:text="@string/section_target" />

            <LinearLayout
                style="@style/Card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <RadioGroup
                    android:id="@+id/group_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                style="@style/Section"
                android:text="@string/section_options" />

            <!-- The defaults suit almost every phone: one line shows them, a tap opens the choices -->
            <LinearLayout
                style="@style/Card"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:id="@+id/btn_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_options_summary"
                        style="@style/Body"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/img_options_arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panel_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <TextView
                        style="@style/Label"
                        android:layout_marginTop="8dp"
                        android:text="@string/label_threads" />

                    <RadioGroup
                        android:id="@+id/group_threads"
                        style="@style/ChipRow">

                        <RadioButton
                            android:id="@+id/rb_tauto"
                            style="@style/Chip"
                            android:layout_weight="1.6"
                            android:text="@string/threads_auto_chip" />

                        <RadioButton
                            android:id="@+id/rb_t2"
                            style="@style/Chip"
                            android:text="@string/n2" />

                        <RadioButton
                            android:id="@+id/rb_t4"
                            style="@style/Chip"
                            android:text="@string/n4" />

                        <RadioButton
                            android:id="@+id/rb_t8"
                            style="@style/Chip"
                            android:text="@string/n8" />

                        <RadioButton
                            android:id="@+id/rb_t16"
                            style="@style/Chip"
                            android:text="@string/n16" />

                        <RadioButton
                            android:id="@+id/rb_t32"
                            style="@style/Chip"
                            android:layout_marginEnd="0dp"
                            android:text="@string/n32" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/txt_threads_hint"
                        style="@style/Hint" />

                    <TextView
                        style="@style/Label"
                        android:text="@string/label_passes" />

                    <RadioGroup
                        android:id="@+id/group_passes"
                        style="@style/ChipRow">

                        <RadioButton
                            android:id="@+id/rb_p1"
                            style="@style/Chip"
                            android:text="@string/n1" />

                        <RadioButton
                            android:id="@+id/rb_p2"
                            style="@style/Chip"
                            android:text="@string/n2" />

                        <RadioButton
                            android:id="@+id/rb_p3"
                            style="@style/Chip"
                            android:layout_marginEnd="0dp"
                            android:text="@string/n3" />
                    </RadioGroup>

                    <TextView
                        style="@style/Hint"
                        android:text="@string/hint_passes" />

                    <Switch
                        android:id="@+id/sw_keep_screen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="48dp"
                        android:text="@string/keep_screen"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_start"
                style="@style/PrimaryButton"
                android:layout_marginTop="20dp"
                android:text="@string/btn_start" />

            <TextView
                android:id="@+id/txt_last_result"
                style="@style/Hint"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Log: appears once there is something to show -->
        <LinearLayout
            android:id="@+id/panel_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Section"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/section_log" />

                <Button
                    android:id="@+id/btn_copy_log"
                    style="@style/TextButton"
                    android:text="@string/btn_copy_log" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_log"
                style="@style/Mono"
                android:background="@drawable/card_bg"
                android:padding="12dp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
